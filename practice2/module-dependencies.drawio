        </mxCell>

        <mxCell id="m_coding" value="&lt;b&gt;coding-agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;AgentSession 串起模型、工具、扩展和压缩；&lt;br&gt;interactive/print/rpc 三种模式复用同一会话；构建时由 esbuild 打包。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="600" y="45" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="m_evals" value="&lt;b&gt;evals&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#8a6d3b&quot;&gt;用例按变体和重复次数展开成任务；&lt;br&gt;docker 为每个变体建镜像，report 配对 vitest JSON 算差值。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff8e1;strokeColor=#9a6700;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="120" y="45" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="m_agent" value="&lt;b&gt;agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;Agent 持有消息数组；每轮把消息和工具定义交给 streamFn，&lt;br&gt;收到 toolCall 后执行并追加 toolResult。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="560" y="210" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m_env" value="&lt;b&gt;env&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;daemon 在 stdin/stdout 上用长度前缀帧收发请求；&lt;br&gt;Connection 配对请求 id，SSH 负责部署并启动 daemon。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="120" y="210" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m_durable" value="&lt;b&gt;durable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;会话和任务状态写成 chord 文档，运行前先 commit；&lt;br&gt;调度器恢复未完成 task，compaction 另起任务压缩上下文。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="520" y="370" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m_chord" value="&lt;b&gt;chord&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;对象跨进程只传引用；host 按 facet 激活插件，&lt;br&gt;文档用 delta 记录修改并写入 store。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="100" y="540" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m_ai" value="&lt;b&gt;ai&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;provider 目录做请求与流解析；&lt;br&gt;catalog 生成模型清单，auth/ 解析凭据。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m_codemode" value="&lt;b&gt;codemode&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;脚本在 QuickJS 实例中执行，宿主只暴露 tools 表；&lt;br&gt;text/image 收集到 output，return 值放到 value。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="700" y="540" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m_mcp" value="&lt;b&gt;mcp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;客户端用 id 配对 JSON-RPC 请求；&lt;br&gt;stdio/HTTP/pipe 只负责收发帧；&lt;br&gt;OAuth 单独实现。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="1000" y="540" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m_tui" value="&lt;b&gt;tui&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;组件 render() 返回行；&lt;br&gt;两支渲染器只写变化行，输入经 keys 分发。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="1260" y="540" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m_schema" value="&lt;b&gt;schema&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;builders 只产出普通 JSON 对象；compile 把它转成校验闭包；&lt;br&gt;Static 从同一份定义推出 TypeScript 类型。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="320" y="735" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="m_telemetry" value="&lt;b&gt;telemetry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#57606a&quot;&gt;span、计数器和直方图都以回调上报；&lt;br&gt;内存记录器保存事件，testing/ 用同一组断言检查适配器。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#30363d;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="680" y="735" width="280" height="110" as="geometry" />
        </mxCell>

